<string id="siteStatReferralURI"><![CDATA[http://uk.sitestat.com/c5/test/s?name={screen}&c5_vid={deviceId}&ns_referrer={referrer}&c5_mp={appId}&c5_mv={appVer}&ns_st_mp={appId}&ns_st_mv={appVer}&c5_vs_pr=c5&c5_vs_pl=gc&c5_vs_de=ps4&ns_site=test]]></string>
