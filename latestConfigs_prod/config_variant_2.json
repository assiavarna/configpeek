<!-- FreeWheel for Panasonic -->
<string id="panasonicFreewheelVideoProfile"><![CDATA[379364:c5_freesat_video]]></string>
<string id="panasonicFreewheelVideoProfileLive"><![CDATA[380007:c5_freesat_video]]></string>
