<?xml version="1.0" encoding="UTF-8"?>
<config>
	<!-- To determine if upgrade is required -->
	<string id="minRequiredAppVersion"><![CDATA[0.2]]></string>
	<!-- GENERAL AUDITUDE CONFIGURATION -->
	<string id="auditudeDomain"><![CDATA[auditude.com]]></string>
	<string id="auditudeVersion"><![CDATA[adunit-1.0]]></string> <!-- five-1.0 when in release -->

	<!-- EDNA -->
	<!-- Channel ids for which calls to Edna are made -->	
	<string id="ednaChannelIDs">c5,c6,c7</string>	
	<!-- Readable channel names displayed in the UI, matched against the above channel ids -->
	<string id="readableChannelNames">Channel 5,5 Star,5 USA</string>
	<!-- URI moved in target specific files -->	
	
	<!-- "RECENT" -->
	<!-- Number of days of content to display in "Recent" grid, applied to Edna TX dates -->
	<string id="ednaFromDateDaysOffset">-30</string>	
	<!-- Additional offset (in hours) applied to data in "Recent" grid, to allow for potential publication delays -->
	<string id="ednaTillDateHoursOffset">1</string>	
	
	<!-- "SHOWS" -->
	<!-- Genres displayed in the portal's "Shows" section. Items are displayed in order as they appear below. See separate specification for more information -->
	<genres>
		<genre id="Popular" navigationLabel="Popular" isPopular="true"/>
		<genre id="Entertainment" navigationLabel="Entertainment"/>
		<genre id="Drama" navigationLabel="Drama"/>
		<genre id="Documentary" navigationLabel="Documentary"/>
		<genre id="Soap" navigationLabel="Soap"/>
		<genre id="Sport" navigationLabel="Sport"/>
                <genre id="Milkshake!" assetId="assets.MainNavigation.milkshake"/>
		<genre id="Films" navigationLabel="Film"/>
	</genres>
	
	<!-- IMAGES -->
	<!-- Base URIs of programme images -->
	<string id="imageAssetsEpisodeBaseURI"><![CDATA[http://api-images.channel5.com/images/episode/]]></string>
	<string id="imageAssetsShowBaseURI"><![CDATA[http://api-images.channel5.com/images/show/]]></string>
	
	<string id="cridTemplate"><![CDATA[crid://panorama.five.tv/versions/{c5id}{version}]]></string>
	
	<string id="useSOSServer">false</string>
	<string id="SOSServerHost">192.168.1.100</string>
	<string id="SOSServerPort">4444</string>
	
	<!-- SAMSUNG_AIR TARGET SPECIFIC CONFIG PARAMETERS -->
        	<!-- SUBTITLES -->
	<string id="subtitlesURI"><![CDATA[xml/]]></string>


	
	<!-- PS3 TARGET SPECIFIC CONFIG PARAMETERS -->
        	<!-- Auditude -->
	<string id="auditudeZoneID"><![CDATA[115707]]></string>
	
	<!-- Reporting -->
	<string id="streamSenseURI"><![CDATA[http://uk.sitestat.com/c5/test/s?name=ps3-demand5.player]]></string>
	<string id="siteStatReferralURI"><![CDATA[http://uk.sitestat.com/c5/test/s?name={screen}&c5_vid={deviceId}&ns_referrer={referrer}&c5_mp={appId}&c5_mv={appVer}&ns_st_mp={appId}&ns_st_mv={appVer}]]></string>
	<string id="siteStatURI"><![CDATA[http://uk.sitestat.com/c5/test/s?name={screen}&c5_vid={deviceId}&c5_mp={appId}&c5_mv={appVer}&ns_st_mp={appId}&ns_st_mv={appVer}]]></string>
	<string id="reportingAppId">PS3_Demand5</string>
	<string id="reportingAppVersion">1.0</string>

	<!-- Edna URI for calls to retrieve VOD metadata, appended to the above Edna base URI -->
	<!-- <string id="ednaChannelsURI"><![CDATA[proxy.php?url=http://api.channel5.com/youview/{0}.xml]]></string> -->
	<string id="ednaChannelsURI"><![CDATA[proxy.php?url=http://api.channel5.com/youview/{0}.json?version=concise]]></string>
	<string id="featuredURI"><![CDATA[proxy.php?url=http://api.channel5.com/carousel/youview/featured.xml]]></string>
	<string id="popularURI"><![CDATA[proxy.php?url=http://api.channel5.com/youview/popular.xml]]></string>
<!-- 	<string id="ednaChannelsURI"><![CDATA[xml/c5.xml]]></string>
 --><!-- 	<string id="featuredURI"><![CDATA[xml/featured.xml]]></string>
	<string id="popularURI"><![CDATA[xml/popular.xml]]></string> -->
    <string id="suppressAds">false</string>
	<string id="pinRemniderURI"><![CDATA[http://www.channel5.com/portable_player/email_pin_reminder?e={0}&p={1}]]></string>


	<string id="cassieEnabled">true</string>
	<string id="cassieMediaURI"><![CDATA[xml/{c5Id}.xml]]></string>


 </config>