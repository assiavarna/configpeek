<?xml version="1.0" encoding="UTF-8"?>
<config>
<string id="minRequiredAppVersion"><![CDATA[0.2]]></string>
<!-- IMAGES -->
<!-- Base URIs of programme images -->
<string id="imageAssetsEpisodeBaseURI"><![CDATA[http://api-images.channel5.com/images/episode/]]></string>
<string id="imageAssetsShowBaseURI"><![CDATA[http://api-images.channel5.com/images/show/]]></string>
<!-- SHOW GENRES -->
<!-- Genres displayed in the portal's "Shows" section. Items are displayed in order as they appear below. -->
<genres>
<genre isPopular="true" id="Popular" navigationLabel="Popular" />
<genre id="Entertainment" navigationLabel="Entertainment" />
<genre id="Drama" navigationLabel="Drama" />
<genre id="Documentary" navigationLabel="Documentary" />
<genre id="Soap" navigationLabel="Soap" />
<genre id="Sport" navigationLabel="Sport" />
<genre id="Milkshake!" assetId="assets.MainNavigation.milkshake" />
<genre id="Film" navigationLabel="Film" />
</genres>
<!-- CASSIE -->
<string id="cassieEnabled"><![CDATA[true]]></string>
<string id="cassieMediaURI"><![CDATA[https://cassie-auth2-staging.channel5.com/media/samsung/{c5Id}.xml]]></string>
<!-- EDNA -->
<string id="ednaChannelsURI"><![CDATA[http://samsung-feed-staging.channel5.com/concise/{0}.json]]></string>
<string id="featuredURI"><![CDATA[http://samsung-feed-staging.channel5.com/featured.xml]]></string>
<string id="popularURI"><![CDATA[http://youview-feed-staging.channel5.com/popular.xml]]></string>
<!-- Channel ids for which calls to Edna are made -->
<string id="ednaChannelIDs"><![CDATA[c5,c6,c7,c1,c2]]></string>
<!-- Readable channel names displayed in the UI, matched against the above channel ids -->
<string id="readableChannelNames"><![CDATA[Channel 5, 5 Star, 5 USA, Demand 5 Exclusive, Spike]]></string>
<!-- Number of days of content to display in "Recent" grid, applied to Edna TX dates -->
<string id="ednaFromDateDaysOffset"><![CDATA[30]]></string>
<!-- Additional offset (in hours) applied to data in "Recent" grid, to allow for potential publication delays -->
<string id="ednaTillDateHoursOffset"><![CDATA[1]]></string>
<!-- FREEWHEEL -->
<string id="freewheelDisableSmoothStreaming"><![CDATA[false]]></string>
<string id="useFreewheelVmap"><![CDATA[true]]></string>
<string id="freewheelVideoProfile"><![CDATA[380990:c5_freesat_video]]></string>
<string id="freewheelVmapServiceUri"><![CDATA[http://23571.v.fwmrm.net/ad/g/1?flag=+emcr+exvt+sltp+slcb&metr=959&nw=380990&resp=vmap1&caid={c5id}&csid=freesat_d5&prof={freewheelVideoProfile}&pvrn={pvrn}&vprn={vprn}]]></string>
<!-- Reporting -->
<string id="analyticsVideoURL"><![CDATA[http://b.scorecardresearch.com/p2?name=demand5.samsung.player.page&c12={deviceId}&c1=19&c2=16184513&c4=demand5.samsung&c5_vs_pr=c5&c5_vs_pl=tv&c5_vs_de=sam&ns_site=test&ns_st_it=p&c5_vs_ct=vi&c5_vs_vt=lf]]></string>
<string id="analyticsMeasurementURL"><![CDATA[http://b.scorecardresearch.com/p2?c12={deviceId}&c5_vs_pr=c5&c5_vs_pl=tv&c5_vs_de=sam&c1=19&c2=16184513&c4=demand5.samsung&ns_nc=1&ns_ap_pn=samsung&ns_ap_device=samsung&ns_site=test]]></string>
<string id="analyticsReferralURL"><![CDATA[http://b.scorecardresearch.com/p2?c12={deviceId}&c5_vs_pr=c5&c5_vs_pl=tv&c5_vs_de=sam&c1=19&c2=16184513&c4=demand5.samsung&ns_nc=1&ns_ap_pn=samsung&ns_ap_device=samsung&ns_site=test&ns_referrer={referrer}]]></string>
<string id="reportingApp"><![CDATA[d5]]></string>
<string id="reportingPlatform"><![CDATA[samsung]]></string>
<string id="reportingAppId"><![CDATA[Samsung_Demand5]]></string>
</config>
