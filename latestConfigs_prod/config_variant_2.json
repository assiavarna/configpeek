<string id="panasonicFreewheelVmapServiceUriLive"><![CDATA[http://5cc67.v.fwmrm.net/ad/g/1?metr=959&nw=380007&resp=vmap1&caid={c5id}&csid=freesat_d5&prof={freewheelVideoProfile}&pvrn={pvrn}&vprn={vprn}&flag=+emcr+exvt+sltp+slcb]]></string>
<!-- FreeWheel for Unknown Devices -->
<string id="freewheelVideoProfile"><![CDATA[379364:c5_freesat_video]]></string>
