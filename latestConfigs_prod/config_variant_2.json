<string id="freewheelVmapServiceUri"><![CDATA[http://5c9e4.v.fwmrm.net/ad/g/1?metr=959&nw=379364&resp=vmap1&caid={c5id}&csid=freesat_d5&prof={freewheelVideoProfile}&pvrn={pvrn}&vprn={vprn}&flag=+emcr+exvt+sltp+slcb]]></string>
