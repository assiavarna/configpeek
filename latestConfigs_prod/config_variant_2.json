<config >
<string id="minRequiredAppVersion"><![CDATA[0.2]]></string>
<!-- EDNA -->
<!-- Channel ids for which calls to Edna are made -->
<string id="ednaChannelIDs"><![CDATA[c5,c6,c7]]></string>
<!-- RECENT -->
<!-- Readable channel names displayed in the UI, matched against the above channel ids -->
<string id="readableChannelNames"><![CDATA[Channel 5,5 Star,5 USA]]></string>
<!-- Number of days of content to display in "Recent" grid, applied to Edna TX dates -->
<string id="ednaFromDateDaysOffset"><![CDATA[30]]></string>
<!-- Additional offset (in hours) applied to data in "Recent" grid, to allow for potential publication delays -->
<string id="ednaTillDateHoursOffset"><![CDATA[1]]></string>
<!-- IMAGES -->
<!-- Base URIs of programme images -->
<string id="imageAssetsEpisodeBaseURI"><![CDATA[http://api-images.channel5.com/images/episode/]]></string>
<string id="imageAssetsShowBaseURI"><![CDATA[http://api-images.channel5.com/images/show/]]></string>
<string id="cridTemplate"><![CDATA[crid://panorama.five.tv/versions/{c5id}{version}]]></string>
<!-- SOS Remote logging
<string id="useSOSServer"><![CDATA[false]]></string>
<string id="SOSServerHost"><![CDATA[192.168.1.100]]></string>
<string id="SOSServerPort"><![CDATA[4444]]></string> -->
<!-- Http Remote Logging
<string id="useHttpLogger"><![CDATA[true]]></string>
<string id="httpLogChannel"><![CDATA[ns-channel-scott]]></string>
<string id="httpLoggerHost"><![CDATA[http://31.221.79.52:4334/Logd]]></string>
<string id="useScreenLogging"><![CDATA[false]]></string> -->
<!-- SHOWS -->
<!-- Genres displayed in the portal's "Shows" section. Items are displayed in order as they appear below. See separate specification for more information -->
<genres ><genre isPopular="true" id="Popular" navigationLabel="Popular" /><genre id="Entertainment" navigationLabel="Entertainment" /><genre id="Drama" navigationLabel="Drama" /><genre id="Documentary" navigationLabel="Documentary" /><genre id="Soap" navigationLabel="Soap" /><genre id="Sport" navigationLabel="Sport" /><genre id="Milkshake!" assetId="assets.MainNavigation.milkshake" /><genre id="Film" navigationLabel="Film" /></genres>
<!-- Subtitles -->
<string id="subtitlesURI"><![CDATA[http://assets.five.tv/test/samsung/ttml/{c5Id}.ttml]]></string>
<!-- Reporting -->
<string id="streamSenseURI"><![CDATA[http://uk.sitestat.com/c5/fivedownload/s?name=video.c5ID:{mediaId}&c5_vid={deviceId}]]></string>
<string id="siteStatReferralURI"><![CDATA[http://uk.sitestat.com/c5/fivedownload/s?name={screen}&c5_vid={deviceId}&ns_referrer={referrer}&c5_mp={appId}&c5_mv={appVer}&ns_st_mp={appId}&ns_st_mv={appVer}]]></string>
<string id="siteStatURI"><![CDATA[http://uk.sitestat.com/c5/fivedownload/s?name={screen}&c5_vid={deviceId}&c5_mp={appId}&c5_mv={appVer}&ns_st_mp={appId}&ns_st_mv={appVer}]]></string>
<!-- Reporting for Humax -->
<string id="humaxReportingAppId"><![CDATA[Freesat_Demand5]]></string>
<!-- Reporting for Panasonic -->
<string id="panasonicReportingAppId"><![CDATA[Freesatpana_Demand5]]></string>
<!-- Reporting for Unknown Device -->
<string id="reportingAppId"><![CDATA[Freesat_Demand5]]></string>
<string id="pinRemniderURI"><![CDATA[http://www.channel5.com/portable_player/email_pin_reminder?e={0}&p={1}]]></string>
<!-- Edna URI for calls to retrieve VOD metadata, appended to the above Edna base URI -->
<string id="ednaChannelsURI"><![CDATA[http://freesat-feed.channel5.com/concise/{0}.json]]></string>
<string id="featuredURI"><![CDATA[http://freesat-feed.channel5.com/featured.xml]]></string>
<string id="popularURI"><![CDATA[http://youview-feed.channel5.com/popular.xml]]></string>
<!-- Cassie -->
<string id="cassieEnabled"><![CDATA[true]]></string>
<string id="cassieMediaURI"><![CDATA[https://cassie-auth.channel5.com/media/freesat/{c5Id}.xml]]></string>
<!-- PlayReady-->
<string id="playReadyLicenseRequest"><![CDATA[<?xml version="1.0" encoding="utf-8"?><PlayReadyInitiator xmlns="http://schemas.microsoft.com/DRM/2007/03/protocols/"><LicenseServerUriOverride><LA_URL>{url}</LA_URL></LicenseServerUriOverride></PlayReadyInitiator>]]></string>
<string id="playReadyLicenseURLRequest"><![CDATA[<?xml version="1.0" encoding="utf-8"?><PlayReadyInitiator xmlns="http://schemas.microsoft.com/DRM/2007/03/protocols/"><LicenseServerUriOverride><LA_URL>{url}</LA_URL></LicenseServerUriOverride></PlayReadyInitiator>]]></string>
<string id="playReadyLicenseCustomDataRequest"><![CDATA[<?xml version="1.0" encoding="utf-8"?><PlayReadyInitiator xmlns="http://schemas.microsoft.com/DRM/2007/03/protocols/"><SetCustomData><CustomData>{customData}</CustomData></SetCustomData></PlayReadyInitiator>]]></string>
<!-- FreeWheel -->
<string id="freewheelDisableSmoothStreaming"><![CDATA[false]]></string>
<string id="useFreewheelVmap"><![CDATA[true]]></string>
<!-- FreeWheel for Humax -->
<string id="humaxFreewheelVideoProfile"><![CDATA[379364:c5_freesat_video]]></string>
